### Create Service - Product Service
POST http://localhost:1236/api/v1/service
Content-Type: application/json

{
  "name": "product",
  "projectId": 1,
  "description": "Product management service",
  "multilingual": true,
  "ast": {
    "table": {
      "name": "products",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "isNull": false
        },
        {
          "name": "price",
          "type": "decimal",
          "isNull": false
        },
        {
          "name": "description",
          "type": "string",
          "isNull": true
        },
        {
          "name": "category",
          "type": "string",
          "isNull": false
        },
        {
          "name": "stock",
          "type": "int",
          "isNull": false,
          "default": "0"
        }
      ]
    },
    "find_route": [
      {
        "route": "/search",
        "method": "GET",
        "func": "search",
        "queries": [
          {
            "name": "name",
            "type": "string",
            "required": false,
            "column": "name",
            "op": "ILIKE"
          },
          {
            "name": "category",
            "type": "string",
            "required": false,
            "column": "category",
            "op": "="
          }
        ],
        "response": {
          "fields": ["id", "name", "price", "category", "stock"],
          "preloads": []
        }
      }
    ],
    "find_one_route": [
      {
        "route": "/:id",
        "method": "GET",
        "func": "getById",
        "path": [
          {
            "name": "id",
            "type": "int",
            "required": true
          }
        ],
        "response": {
          "fields": ["*"],
          "preloads": []
        }
      }
    ],
    "create_route": [
      {
        "route": "",
        "method": "POST",
        "func": "create"
      }
    ],
    "update_route": [
      {
        "route": "/:id",
        "method": "PATCH",
        "func": "update"
      }
    ]
  }
}

### Create Service - Category Service
POST http://localhost:1236/api/v1/service
Content-Type: application/json

{
  "name": "category",
  "projectId": 1,
  "description": "Category management service",
  "multilingual": false,
  "ast": {
    "table": {
      "name": "categories",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "isNull": false
        },
        {
          "name": "description",
          "type": "string",
          "isNull": true
        },
        {
          "name": "parent_id",
          "type": "int",
          "isNull": true,
          "relation": {
            "table": "categories",
            "type": "many-to-one",
            "refColumn": "id"
          }
        }
      ]
    },
    "find_route": [
      {
        "route": "/list",
        "method": "GET",
        "func": "list",
        "response": {
          "fields": ["id", "name", "description"],
          "preloads": []
        }
      }
    ],
    "find_one_route": [
      {
        "route": "/:id",
        "method": "GET",
        "func": "getById",
        "path": [
          {
            "name": "id",
            "type": "int",
            "required": true
          }
        ],
        "response": {
          "fields": ["*"],
          "preloads": []
        }
      }
    ],
    "create_route": [
      {
        "route": "",
        "method": "POST",
        "func": "create"
      }
    ],
    "update_route": [
      {
        "route": "/:id",
        "method": "PATCH",
        "func": "update"
      }
    ]
  }
}